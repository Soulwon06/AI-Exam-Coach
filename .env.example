# Optional local overrides. The defaults in backend/app/core/config.py are
# sufficient for the heuristic, SQLite-based demo.
AEC_DATABASE_URL=sqlite:///./data/aiexamcoach.db
AEC_AI_PROVIDER=heuristic

# Optional OpenAI-compatible provider settings. Keep credentials only in .env.
# For DeepSeek, use https://api.deepseek.com/v1 and model deepseek-chat.
# AEC_OPENAI_API_KEY=
# AEC_OPENAI_BASE_URL=https://api.openai.com/v1
# AEC_OPENAI_MODEL=gpt-4o-mini

AEC_MAX_WORKERS=4
AEC_MAX_UPLOAD_MB=100

# Account sessions use HttpOnly cookies. Enable Secure when serving over HTTPS.
AEC_AUTH_SESSION_TTL_HOURS=168
AEC_AUTH_COOKIE_SECURE=false
AEC_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional preconfigured account for a trusted local database only.
# The account must link to an existing local course owner; do not publish real credentials.
# AEC_DEMO_USERNAME=demo
# AEC_DEMO_PASSWORD=replace-with-a-long-private-password
# AEC_DEMO_COURSE_ID=
